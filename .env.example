# Quién Gana — environment variables (SPEC §13)
# Copy to .env.local and fill in. NEVER commit .env.local.
# All resources below must be DEDICATED to this project — do not reuse
# Bon Bon Clean or Kollab Supabase/Vercel/API credentials here.

# --- Database (Supabase) ---
DATABASE_URL=
DIRECT_URL=                        # For migrations
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # Server-only — never expose to client

# --- Auth ---
SUPABASE_AUTH_SIGNING_SECRET=

# --- Inngest (jobs) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- External APIs ---
NEWSAPI_KEY=
USASPENDING_BASE_URL=https://api.usaspending.gov
PACER_USERNAME=
PACER_PASSWORD=
AIRDNA_API_KEY=                    # Phase 6+

# --- Email ---
RESEND_API_KEY=

# --- Map tiles ---
PROTOMAPS_API_KEY=                 # If using hosted Protomaps; otherwise self-host

# --- Monitoring ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Crypto ---
INTAKE_ENCRYPTION_KEY=             # 32-byte hex for intake contact encryption
IP_HASH_SALT=                      # Random secret for hashing contributor IPs

# --- Site config ---
NEXT_PUBLIC_SITE_URL=https://quiengana.org
NEXT_PUBLIC_DEFAULT_LOCALE=es
